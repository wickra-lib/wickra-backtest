/target
**/*.rs.bk
Cargo.lock.bak
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.pdb

# Coverage output. `cargo llvm-cov` writes lcov.info to the repository root and
# scatters *.profraw during instrumentation, so both show up as untracked after
# running the coverage job's command locally.
lcov.info
*.profraw

# Python build artifacts
__pycache__/
*.py[cod]
*.so
*.pyd
*.egg-info/
dist/
.venv/
build/
.pytest_cache/

# Node build artifacts (index.js / index.d.ts ARE committed)
node_modules/
*.node
# The licence texts are staged into each npm package at publish time; the
# copies at the repository root are the only ones that belong in git.
bindings/node/LICENSE-*
bindings/node/npm/*/LICENSE-*

# WASM build output (regenerated by wasm-pack)
pkg/

# .NET build artifacts
bin/
obj/
# CI packs the NuGet package here to check the packaging metadata.
nupkg/

# Java / Maven build artifacts
bindings/java/target/
bindings/java/benchmarks/target/
examples/java/target/

# R build artifacts
bindings/r/.rlib/
bindings/r/src/*.o
bindings/r/src/*.so
bindings/r/src/*.dll
bindings/r/..Rcheck/

# R binding: produced by configure / configure.win at install time.
bindings/r/src/Makevars
bindings/r/src/wickra_backtest.h
bindings/r/src/wickra_backtest.dll
bindings/r/src/libwickra_backtest.*
bindings/r/src/wickra-backtest-c/
bindings/r/src/wickra-backtest-c.tar.gz
