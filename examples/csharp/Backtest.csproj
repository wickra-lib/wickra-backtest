<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Wickra.Backtest.Examples</RootNamespace>
    <AssemblyName>backtest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../bindings/csharp/Wickra.Backtest/Wickra.Backtest.csproj" />
  </ItemGroup>

  <!-- Copy the native C-ABI library next to the executable so P/Invoke finds it.
       Build it first: cargo build -p wickra-backtest-c -->
  <ItemGroup>
    <Content Include="../../target/debug/wickra_backtest.dll" Condition="Exists('../../target/debug/wickra_backtest.dll')">
      <Link>wickra_backtest.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../target/debug/libwickra_backtest.so" Condition="Exists('../../target/debug/libwickra_backtest.so')">
      <Link>libwickra_backtest.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../target/debug/libwickra_backtest.dylib" Condition="Exists('../../target/debug/libwickra_backtest.dylib')">
      <Link>libwickra_backtest.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
