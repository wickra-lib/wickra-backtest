# Keep compiled artifacts out of the R source tarball built by `R CMD build`.
# The package links the C ABI out-of-tree, so only the glue objects and any
# locally built shared library live under src/ — none of them belong in a
# distributable source package; they are produced at install.
^src/.*\.o$
^src/.*\.so$
^src/.*\.dll$
^src/.*\.dylib$
^src/symbols\.rds$
^\.gitignore$
# Generated at configure time, never shipped in the source tarball: the Makevars
# produced from Makevars.in, the staged C ABI header and library, and the
# downloaded release asset with its extraction directory.
^src/Makevars$
^src/wickra_backtest\.h$
^src/wickra-backtest-c\.tar\.gz$
^src/wickra-backtest-c$
^src/libwickra_backtest\.

