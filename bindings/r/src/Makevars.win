# configure.win stages the C ABI header and wickra_backtest.dll into src/, so the
# package object links against the bundled copy. mingw links directly against a
# DLL with `-l:`; no import library is needed because the package object
# (wickrabacktest.dll) and the ABI (wickra_backtest.dll) have different names and
# cannot shadow one another.
PKG_CPPFLAGS = -I.
PKG_LIBS = -L. -l:wickra_backtest.dll
