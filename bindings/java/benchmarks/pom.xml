<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.wickra</groupId>
  <artifactId>wickra-backtest-benchmarks</artifactId>
  <version>0.1.2</version>
  <packaging>jar</packaging>

  <name>wickra-backtest throughput benchmark (Java)</name>
  <description>Measures the per-bar cost of the Java binding's FFI boundary.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>22</maven.compiler.release>
    <!-- The RELEASE C ABI, unlike the binding's own pom, which points at the
         debug build because its tests do not care how fast the engine is. A
         benchmark against an unoptimised engine measures the debug build.
         Build it first with the release profile. -->
    <native.lib.dir>${project.basedir}/../../../target/release</native.lib.dir>
    <exec.mainClass>org.wickra.backtest.benchmarks.Throughput</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.wickra</groupId>
      <artifactId>wickra-backtest</artifactId>
      <version>0.1.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>

      <!--
        Run in a forked JVM with native access granted and the C ABI on the
        loader path:
          mvn -f bindings/java/benchmarks compile exec:exec
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <arguments>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-Djava.library.path=${native.lib.dir}</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>${exec.mainClass}</argument>
            <argument>${bars}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>default-bars</id>
      <activation>
        <property><name>!bars</name></property>
      </activation>
      <properties>
        <bars>200000</bars>
      </properties>
    </profile>
  </profiles>

</project>
