<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wickra.Backtest/Wickra.Backtest.csproj" />
  </ItemGroup>

  <!-- Copy the native C-ABI library next to the test assembly so P/Invoke finds it.
       Build it first: cargo build -p wickra-backtest-c -->
  <ItemGroup>
    <Content Include="../../../target/debug/wickra_backtest.dll" Condition="Exists('../../../target/debug/wickra_backtest.dll')">
      <Link>wickra_backtest.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../../target/debug/libwickra_backtest.so" Condition="Exists('../../../target/debug/libwickra_backtest.so')">
      <Link>libwickra_backtest.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../../target/debug/libwickra_backtest.dylib" Condition="Exists('../../../target/debug/libwickra_backtest.dylib')">
      <Link>libwickra_backtest.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
