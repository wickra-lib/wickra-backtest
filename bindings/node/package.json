{
  "name": "wickra-backtest",
  "version": "0.1.2",
  "description": "Streaming-native backtester for the Wickra technical-indicator library. Node bindings powered by Rust.",
  "author": "kingchenc <support@wickra.org>",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "backtesting",
    "trading",
    "technical-analysis",
    "quant",
    "streaming",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wickra-lib/wickra-backtest"
  },
  "bugs": {
    "url": "https://github.com/wickra-lib/wickra-backtest/issues"
  },
  "homepage": "https://github.com/wickra-lib/wickra-backtest",
  "engines": {
    "node": ">= 22"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "napi": {
    "binaryName": "wickra-backtest",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {
    "wickra-backtest-linux-x64-gnu": "0.1.2",
    "wickra-backtest-linux-arm64-gnu": "0.1.2",
    "wickra-backtest-darwin-x64": "0.1.2",
    "wickra-backtest-darwin-arm64": "0.1.2",
    "wickra-backtest-win32-x64-msvc": "0.1.2",
    "wickra-backtest-win32-arm64-msvc": "0.1.2"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts --output-dir artifacts",
    "version": "napi version",
    "test": "node --test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.4"
  }
}
