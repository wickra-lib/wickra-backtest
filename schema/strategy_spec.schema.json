{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StrategySpec",
  "description": "A complete strategy specification.",
  "type": "object",
  "properties": {
    "costs": {
      "description": "Trading costs.",
      "allOf": [
        {
          "$ref": "#/definitions/Costs"
        }
      ],
      "default": {
        "funding": false,
        "maker_bps": 0.0,
        "slippage": {
          "bps": 0.0,
          "type": "fixed_bps"
        },
        "taker_bps": 0.0
      }
    },
    "entry": {
      "description": "Long-entry condition.",
      "allOf": [
        {
          "$ref": "#/definitions/Condition"
        }
      ]
    },
    "execution": {
      "description": "Execution model.",
      "allOf": [
        {
          "$ref": "#/definitions/Execution"
        }
      ],
      "default": {
        "fill_timing": "next_open",
        "latency_bars": 0,
        "limit_offset_pct": null,
        "max_participation": null,
        "order_type": "market",
        "partial_fills": false,
        "stop_offset_pct": null
      }
    },
    "exit": {
      "description": "Long-exit condition.",
      "allOf": [
        {
          "$ref": "#/definitions/Condition"
        }
      ]
    },
    "indicators": {
      "description": "Named indicators available to the rules.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/IndicatorSpec"
      }
    },
    "ref_symbol": {
      "description": "The reference instrument a pairwise indicator is meant to be run against.\n\nAlso metadata. Naming it here does not load anything: the reference series\nis passed alongside the candles, through `RunRequest.reference` or\n`run_with_ref`. This field records which instrument the caller is expected\nto pass, so a spec using a pairwise indicator is not ambiguous about what\nit is pairing against.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "risk": {
      "description": "Risk controls.",
      "allOf": [
        {
          "$ref": "#/definitions/Risk"
        }
      ],
      "default": {
        "liquidation": false,
        "max_leverage": null,
        "max_position_pct": null,
        "stop_loss_pct": null,
        "take_profit_pct": null,
        "trailing_stop_pct": null
      }
    },
    "short_entry": {
      "description": "Optional short-entry condition.",
      "anyOf": [
        {
          "$ref": "#/definitions/Condition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "short_exit": {
      "description": "Optional short-exit condition.",
      "anyOf": [
        {
          "$ref": "#/definitions/Condition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sizing": {
      "description": "Position sizing.",
      "allOf": [
        {
          "$ref": "#/definitions/Sizing"
        }
      ]
    },
    "spec_version": {
      "description": "Spec format version (defaults to [`SPEC_VERSION`]).\n\nA spec from an older format still parses -- the DSL only grows within a\nversion -- but one declaring a newer format is rejected rather than\nread with fields this build does not know about.",
      "type": "integer",
      "format": "uint32",
      "default": 1,
      "minimum": 0
    },
    "symbol": {
      "description": "Primary trading symbol.\n\nMetadata, not an input: the engine never resolves it and cannot fetch\ndata. The caller supplies the candles, and this records which instrument\nthey are expected to be, so a stored spec still says what it was written\nfor.",
      "type": "string"
    },
    "timeframe": {
      "description": "Bar timeframe (e.g. `\"1h\"`).\n\nMetadata, like `symbol`: a free-form label recording the bar size the spec\nwas written for. The engine reads whatever candles it is given and does not\ncheck them against this.",
      "type": "string"
    },
    "warmup": {
      "description": "Explicit warmup bars (defaults to the max indicator warmup).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    }
  },
  "required": [
    "symbol",
    "timeframe",
    "indicators",
    "entry",
    "exit",
    "sizing"
  ],
  "definitions": {
    "Condition": {
      "description": "A boolean node — evaluates to true/false each bar.",
      "oneOf": [
        {
          "description": "`a > b`.",
          "type": "object",
          "properties": {
            "gt": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "gt"
          ]
        },
        {
          "description": "`a < b`.",
          "type": "object",
          "properties": {
            "lt": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "lt"
          ]
        },
        {
          "description": "`a >= b`.",
          "type": "object",
          "properties": {
            "ge": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "ge"
          ]
        },
        {
          "description": "`a <= b`.",
          "type": "object",
          "properties": {
            "le": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "le"
          ]
        },
        {
          "description": "`a == b`.",
          "type": "object",
          "properties": {
            "eq": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "eq"
          ]
        },
        {
          "description": "`a != b`.",
          "type": "object",
          "properties": {
            "ne": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "ne"
          ]
        },
        {
          "description": "`a` crosses above `b` this bar.",
          "type": "object",
          "properties": {
            "cross_above": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "cross_above"
          ]
        },
        {
          "description": "`a` crosses below `b` this bar.",
          "type": "object",
          "properties": {
            "cross_below": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "cross_below"
          ]
        },
        {
          "description": "`lo <= a <= hi`: `[a, lo, hi]`.",
          "type": "object",
          "properties": {
            "between": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "between"
          ]
        },
        {
          "description": "`a` is greater than its value `n` bars ago: `[a, n]`.",
          "type": "object",
          "properties": {
            "rising": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "rising"
          ]
        },
        {
          "description": "`a` is less than its value `n` bars ago: `[a, n]`.",
          "type": "object",
          "properties": {
            "falling": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "falling"
          ]
        },
        {
          "description": "All sub-conditions true (AND).",
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all"
          ]
        },
        {
          "description": "Any sub-condition true (OR).",
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any"
          ]
        },
        {
          "description": "Negation.",
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/Condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "not"
          ]
        },
        {
          "description": "True iff a position is currently open.",
          "type": "object",
          "properties": {
            "in_position": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "in_position"
          ]
        },
        {
          "description": "Predicate on the number of bars since entry.",
          "type": "object",
          "properties": {
            "bars_since_entry": {
              "$ref": "#/definitions/IntPredicate"
            }
          },
          "additionalProperties": false,
          "required": [
            "bars_since_entry"
          ]
        }
      ]
    },
    "Costs": {
      "description": "Trading costs.",
      "type": "object",
      "properties": {
        "funding": {
          "description": "Charge perpetual funding each bar to an open position, using the\nderivatives feed's funding rate and mark price (longs pay when the rate\nis positive, shorts receive). Requires a derivatives feed; default off.",
          "type": "boolean",
          "default": false
        },
        "maker_bps": {
          "description": "Maker fee in basis points.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "slippage": {
          "description": "Slippage model.",
          "allOf": [
            {
              "$ref": "#/definitions/Slippage"
            }
          ],
          "default": {
            "bps": 0.0,
            "type": "fixed_bps"
          }
        },
        "taker_bps": {
          "description": "Taker fee in basis points.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      }
    },
    "Execution": {
      "description": "Execution model.",
      "type": "object",
      "properties": {
        "fill_timing": {
          "description": "When a signalled order fills.",
          "allOf": [
            {
              "$ref": "#/definitions/FillTiming"
            }
          ],
          "default": "next_open"
        },
        "latency_bars": {
          "description": "Simulated latency in bars before a fill.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "limit_offset_pct": {
          "description": "Limit-order trigger as a percent offset from the signal bar's close\n(required for `order_type = \"limit\"`). Negative places a long limit\nbelow the market (buy the dip); positive places a short limit above it.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "max_participation": {
          "description": "Maximum fraction of a bar's volume a single entry may consume (required\nwhen `partial_fills` is set).",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "order_type": {
          "description": "Order type.",
          "allOf": [
            {
              "$ref": "#/definitions/OrderType"
            }
          ],
          "default": "market"
        },
        "partial_fills": {
          "description": "Whether partial fills are modelled. When set, an entry fills at most\n`max_participation * bar_volume` and the unfilled remainder is cancelled.",
          "type": "boolean",
          "default": false
        },
        "stop_offset_pct": {
          "description": "Stop-order trigger as a percent offset from the signal bar's close\n(required for `order_type = \"stop\"`). Positive places a long stop above\nthe market (breakout); negative places a short stop below it.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        }
      }
    },
    "Feed": {
      "description": "The data feed an indicator is driven by.",
      "oneOf": [
        {
          "description": "OHLCV candles (default). Also the feed for pairwise indicators, which are\nfed the bar close alongside the reference series' close.",
          "type": "string",
          "const": "kline"
        },
        {
          "description": "Trade prints.",
          "type": "string",
          "const": "trade"
        },
        {
          "description": "Order-book snapshots.",
          "type": "string",
          "const": "orderbook"
        },
        {
          "description": "Trade prints quoted against the book mid.",
          "type": "string",
          "const": "trade_quote"
        },
        {
          "description": "Perpetual/derivatives ticks — funding, open interest, mark and index.",
          "type": "string",
          "const": "derivatives"
        },
        {
          "description": "The market cross-section, for breadth indicators.",
          "type": "string",
          "const": "cross_section"
        }
      ]
    },
    "FillTiming": {
      "description": "When a signalled order fills.",
      "oneOf": [
        {
          "description": "On the next bar's open — the look-ahead-bias-free default.",
          "type": "string",
          "const": "next_open"
        },
        {
          "description": "On the signalling bar's own close (close-to-close execution). An opt-in,\ndeliberately optimistic mode: the fill uses the very close that produced\nthe signal, which is not actually tradeable in live execution. Market\norders only, and incompatible with `latency_bars`.",
          "type": "string",
          "const": "close"
        }
      ]
    },
    "IndicatorSpec": {
      "description": "One indicator instance: a `wickra-core` type name plus its parameters.",
      "type": "object",
      "properties": {
        "feed": {
          "description": "Which feed drives it. Optional, and redundant when present: the indicator\ntype already determines its feed. State it and the spec is cross-checked\nagainst the registry, so a rename or a copied block that no longer matches\nthe indicator fails at parse instead of silently producing no values.",
          "anyOf": [
            {
              "$ref": "#/definitions/Feed"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "description": "Constructor parameters.",
          "type": "array",
          "default": [],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "type": {
          "description": "The `wickra-core` indicator type name (e.g. `\"Ema\"`).",
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    },
    "IntPredicate": {
      "description": "An integer comparison predicate (used by stateful conditions).",
      "oneOf": [
        {
          "description": "`> n`.",
          "type": "object",
          "properties": {
            "gt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "gt"
          ]
        },
        {
          "description": "`< n`.",
          "type": "object",
          "properties": {
            "lt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "lt"
          ]
        },
        {
          "description": "`>= n`.",
          "type": "object",
          "properties": {
            "ge": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "ge"
          ]
        },
        {
          "description": "`<= n`.",
          "type": "object",
          "properties": {
            "le": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "le"
          ]
        },
        {
          "description": "`== n`.",
          "type": "object",
          "properties": {
            "eq": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "eq"
          ]
        }
      ]
    },
    "Operand": {
      "description": "A value node — evaluates to a number each bar.",
      "anyOf": [
        {
          "description": "Indicator reference by name, optionally `\"name.field\"` for multi-output.",
          "type": "string"
        },
        {
          "description": "A literal constant.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "A compound expression.",
          "allOf": [
            {
              "$ref": "#/definitions/OperandExpr"
            }
          ]
        }
      ]
    },
    "OperandExpr": {
      "description": "The object-shaped operand forms.",
      "oneOf": [
        {
          "description": "A price field of the current bar.",
          "type": "object",
          "properties": {
            "price": {
              "$ref": "#/definitions/PriceField"
            }
          },
          "additionalProperties": false,
          "required": [
            "price"
          ]
        },
        {
          "description": "The value of an operand `n` bars ago: `[\"operand\", n]`.",
          "type": "object",
          "properties": {
            "prev": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "prev"
          ]
        },
        {
          "description": "`a + b`.",
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "add"
          ]
        },
        {
          "description": "`a - b`.",
          "type": "object",
          "properties": {
            "sub": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "sub"
          ]
        },
        {
          "description": "`a * b`.",
          "type": "object",
          "properties": {
            "mul": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "mul"
          ]
        },
        {
          "description": "`a / b`.",
          "type": "object",
          "properties": {
            "div": {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/Operand"
                },
                {
                  "$ref": "#/definitions/Operand"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "div"
          ]
        }
      ]
    },
    "OrderType": {
      "description": "Order type.",
      "oneOf": [
        {
          "description": "Market order (default).",
          "type": "string",
          "const": "market"
        },
        {
          "description": "Limit order.",
          "type": "string",
          "const": "limit"
        },
        {
          "description": "Stop order.",
          "type": "string",
          "const": "stop"
        },
        {
          "description": "Stop-limit order.",
          "type": "string",
          "const": "stop_limit"
        }
      ]
    },
    "PriceField": {
      "description": "A price field of the current bar.",
      "oneOf": [
        {
          "description": "Open.",
          "type": "string",
          "const": "open"
        },
        {
          "description": "High.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "Low.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Close.",
          "type": "string",
          "const": "close"
        },
        {
          "description": "Volume.",
          "type": "string",
          "const": "volume"
        },
        {
          "description": "`(high + low + close) / 3`.",
          "type": "string",
          "const": "hlc3"
        },
        {
          "description": "`(open + high + low + close) / 4`.",
          "type": "string",
          "const": "ohlc4"
        }
      ]
    },
    "Risk": {
      "description": "Risk controls (all optional).",
      "type": "object",
      "properties": {
        "liquidation": {
          "description": "Liquidate a leveraged position intrabar at its bankruptcy price (where\naccount equity reaches zero). Only bites above 1x leverage; default off.",
          "type": "boolean",
          "default": false
        },
        "max_leverage": {
          "description": "Maximum leverage.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "max_position_pct": {
          "description": "Maximum position as a percent of equity.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "stop_loss_pct": {
          "description": "Stop-loss as a percent move against the position.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "take_profit_pct": {
